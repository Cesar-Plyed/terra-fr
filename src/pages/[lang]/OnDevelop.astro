---
import MainLayout from "@/layouts/MainLayout.astro";

export async function getStaticPaths() {
  return [{ params: { lang: "en-GB" } }, { params: { lang: "es-MX" } }];
}

const { lang } = Astro.params;
const currentLang = lang === "en-GB" ? "en-GB" : "es-MX";

const copy = {
  "es-MX": {
    title: "Página en construcción",
    eyebrow: "En desarrollo",
    heading: "Estamos cultivando esto",
    description:
      "Esta sección todavía no está lista. Estamos trabajando para que crezca — vuelve pronto.",
    cta: "Volver al inicio",
  },
  "en-GB": {
    title: "Page under construction",
    eyebrow: "In development",
    heading: "We're still growing this one",
    description:
      "This section isn't ready yet. We're working on it — check back soon.",
    cta: "Back to home",
  },
} as const;

const t = copy[currentLang];
---

<MainLayout title={t.title} lang={currentLang}>
  <div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6">
    <div
      class="enter w-full text-center p-8 sm:p-10 rounded-2xl bg-sidebar-bg border border-sidebar-border shadow-lg space-y-6"
    >
      <!-- Ícono: brote creciendo, coherente con "en construcción" -->
      <div class="flex justify-center">
        <div
          class="w-14 h-14 rounded-xl bg-secondary-bg-button border border-secondary-border-button flex items-center justify-center text-subtitle"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 21V10m0 0c0-3 2-5 5-5m-5 5C12 7 10 5 7 5"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M4 21h16"
            ></path>
          </svg>
        </div>
      </div>

      <div class="space-y-2">
        <span
          class="inline-flex items-center px-3 py-1 rounded-full text-[11px] font-semibold bg-secondary-bg-button text-subtitle border border-secondary-border-button uppercase tracking-wide"
        >
          {t.eyebrow}
        </span>
        <h1 class="text-2xl sm:text-3xl font-bold text-title pt-1">
          {t.heading}
        </h1>
        <p class="text-sm text-paragraph leading-relaxed">
          {t.description}
        </p>
      </div>

      <div class="pt-2">
        <a
          href="/"
          class="inline-block px-5 py-2.5 rounded-md bg-primary-bg-button text-title font-semibold text-sm border border-primary-border-button shadow-md hover:opacity-90 transition-opacity"
        >
          {t.cta}
        </a>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .enter {
    opacity: 0;
    transform: translateY(8px);
    animation: enter-fade 0.4s ease-out forwards;
  }

  @keyframes enter-fade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .enter {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>