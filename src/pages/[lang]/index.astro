---
import MainLayout from "@/layouts/MainLayout.astro";
import MainSection from "@components/sections/MainSection.astro";
import OnDevelop from "./OnDevelop.astro";
export async function getStaticPaths() {
  return [{ params: { lang: "en-GB" } }, { params: { lang: "es-MX" } }];
}
const { lang } = Astro.params;
---

<MainLayout>
  {
    lang == "en-GB" ? (
      <div>
        <h1 class="text-2xl sm:text-3xl font-bold text-title max-w-5xl mx-auto w-full leading-snug">
          Englsih version still on working pease go to Spanish Mexico Page
        </h1>
        <div class="flex flex-wrap justify-center gap-4 pt-4">
          <a
            href="/es-MX/"
            class="group inline-flex items-center gap-2 px-6 py-3 rounded-md mx-auto bg-primary-bg-button text-title font-semibold text-sm transition-all duration-200 border border-primary-border-button shadow-md hover:opacity-90"
          >
            <svg
              class="w-4 h-4 transition-transform duration-200 group-hover:translate-x-1"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M14 5l7 7m0 0l-7 7m7-7H3"
              />
            </svg>
          </a>
        </div>
      </div>
    ) : (
      <MainSection />
    )
  }
</MainLayout>
