---
import MainLayout from "@/layouts/MainLayout.astro";
---

<MainLayout title="Página no encontrada · 404">
  <div class="min-h-[70vh] flex items-center justify-center px-4 sm:px-6">
    <div
      class="enter max-w-md w-full text-center p-8 sm:p-10 rounded-2xl bg-sidebar-bg border border-sidebar-border shadow-lg space-y-6"
    >
      <!-- Ícono: brote marchito, en línea con el mundo agrícola de T.E.R.R.A. -->
      <div class="flex justify-center">
        <div
          class="w-14 h-14 rounded-xl bg-secondary-bg-button border border-secondary-border-button flex items-center justify-center text-subtitle"
        >
          <svg
            class="w-7 h-7"
            fill="none"
            stroke="currentColor"
            viewBox="0 0 24 24"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M12 21v-7m0 0c-3.5 0-6-2-6-5.5C6 6 8 4 8 4s1 2.5 4 3c-.5-2 .5-4.5 2-5.5 0 0 2 3 1 6.5-.3 1-1 2-2 2.5 2-.2 4-1.5 5-3.5 0 0 .5 3.5-2 6-1.3 1.3-3 2-5 2z"
            ></path>
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              stroke-width="1.5"
              d="M9 21h6"
            ></path>
          </svg>
        </div>
      </div>

      <div class="space-y-2">
        <p class="text-sm font-semibold text-subtitle tracking-wide">
          Error 404
        </p>
        <h1 class="text-2xl sm:text-3xl font-bold text-title">
          Esta parcela no existe
        </h1>
        <p class="text-sm text-paragraph leading-relaxed">
          El enlace que buscas no está sembrado en nuestro sitio. Puede que
          se haya movido o que la dirección tenga un error.
        </p>
      </div>

      <div class="flex flex-col sm:flex-row gap-3 justify-center pt-2">
        <a
          href="/"
          class="px-5 py-2.5 rounded-md bg-primary-bg-button text-title font-semibold text-sm border border-primary-border-button shadow-md hover:opacity-90 transition-opacity"
        >
          Volver al inicio
        </a>
        <a
          href="/contacto"
          class="px-5 py-2.5 rounded-md bg-secondary-bg-button text-secondary-fg-button font-semibold text-sm border border-secondary-border-button hover:bg-sidebar-item-bg-hover transition-colors"
        >
          Reportar un enlace roto
        </a>
      </div>
    </div>
  </div>
</MainLayout>

<style>
  .enter {
    opacity: 0;
    transform: translateY(8px);
    animation: enter-fade 0.4s ease-out forwards;
  }

  @keyframes enter-fade {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .enter {
      animation: none;
      opacity: 1;
      transform: none;
    }
  }
</style>