---
import AgriParticlesBg from "@components/sections/AgriParticlesBg.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Mi Landing Page",
  description = "Bienvenido a nuestra landing page increíble",
} = Astro.props;
---

<!doctype html>
<html lang="en" class="max-w-dvw max-h-dvh w-full h-full">
  <head>
    <title>{title}</title>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
  </head>
  <body
    class="grid grid-cols-1 grid-rows-[100px_auto_100px] max-w-dvw max-h-dvh w-full h-full"
  >
    <AgriParticlesBg />
    <header class="w-full h-full row-start-1 row-end-2">
      <slot name="header" />
    </header>
    <main class="w-full h-full row-start-2 row-end-3">
      <slot />
    </main>
    <footer class="w-full h-full row-start-3 row-end-4">
      <slot name="footer" />
    </footer>

    <script>
      import Lenis from "lenis";

      // Inicializar Lenis
      const lenis = new Lenis({
        duration: 1.2, // Duración de la inercia (en segundos)
        easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)), // Curva de suavizado
        smoothWheel: true, // Habilitar suavizado con la rueda del ratón
      });

      // Loop de animación
      function raf(time: number) {
        lenis.raf(time);
        requestAnimationFrame(raf);
      }

      requestAnimationFrame(raf);
    </script>
  </body>
</html>
